  if(!req.body.name){
    return res.status(400).json({message:"Name required"})
  }

  const categories = read_file("categories.json")

  categories.push({
    id: uuid.v4(),
    name: req.body.name
  })

  write_file("categories.json", categories)

  res.status(201).json({message:"Added"})
})

